---
import "../styles/tokens.css";
import SEO from "../components/SEO.astro";
import InkBackgroundCanvas from "../components/canvas/InkBackgroundCanvas.svelte";
import AppHeader from "../components/ui/AppHeader.astro";
import Footer from "../components/Footer.astro";
import { buildLocalBusinessJsonLd } from "../lib/seo";
import { ADMIN_PREFIX, THEME_COLOR } from "../lib/config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
}

const { title, description, image, type, noindex } = Astro.props;
const isAdmin = Astro.url.pathname.startsWith(ADMIN_PREFIX);
const localBusinessJsonLd = buildLocalBusinessJsonLd();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="generator" content={Astro.generator} />

    <SEO title={title} description={description} image={image} type={type} noindex={noindex} />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />
  </head>
  <body>
    <div class="backdrop" aria-hidden="true">
      <InkBackgroundCanvas client:only="svelte" />
    </div>
    <div class="top-gradient" aria-hidden="true"></div>
    {!isAdmin && <AppHeader />}
    <main id="main">
      <slot />
    </main>
    {!isAdmin && <Footer />}
  </body>
</html>

<script>
  // Progressive enhancement: swap any broken image to a local placeholder
  // (no island needed; keeps grid integrity — spec edge case / quickstart S2).
  for (const el of document.querySelectorAll<HTMLImageElement>("img[data-fallback]")) {
    el.addEventListener("error", () => {
      const fallback = el.getAttribute("data-fallback");
      el.removeAttribute("data-fallback");
      if (fallback) el.src = fallback;
    });
  }
</script>

<style>
  /* Decorative ink-motion background: fixed, non-interactive, behind content. */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* Warm gold sheen in the first ~third of the viewport height. Layer 0 keeps it
     behind <main> (which has no numeric z-index so overlays are not trapped). */
  .top-gradient {
    position: fixed;
    inset: 0 0 auto 0;
    height: 34vh;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      var(--bg-gradient-top-start) 0%,
      var(--bg-gradient-top-end) 52%,
      transparent 100%
    );
  }

  main {
    position: relative;
    /* No numeric z-index: avoids a stacking context so modals/drawers rendered
       inside <main> can paint above the sticky header (feature 010). */
    /* Grow to fill the viewport so the global footer stays at the bottom. */
    flex: 1 0 auto;
    width: 100%;
  }
</style>
