---
import "../styles/tokens.css";
import InkBackgroundCanvas from "../components/canvas/InkBackgroundCanvas.svelte";
import AppHeader from "../components/ui/AppHeader.astro";
import { STUDIO_PROFILE } from "../lib/types/content";
import { THEME_COLOR } from "../lib/config";

interface Props {
  title?: string;
}

const { title = `${STUDIO_PROFILE.brand} — ${STUDIO_PROFILE.tagline}` } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={STUDIO_PROFILE.bio} />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="backdrop" aria-hidden="true">
      <InkBackgroundCanvas client:only="svelte" />
    </div>
    <div class="top-gradient" aria-hidden="true"></div>
    <AppHeader />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <slot name="footer" />
      <p>{STUDIO_PROFILE.brand} — © {new Date().getFullYear()}</p>
    </footer>
  </body>
</html>

<script>
  // Progressive enhancement: swap any broken image to a local placeholder
  // (no island needed; keeps grid integrity — spec edge case / quickstart S2).
  for (const el of document.querySelectorAll<HTMLImageElement>("img[data-fallback]")) {
    el.addEventListener("error", () => {
      const fallback = el.getAttribute("data-fallback");
      el.removeAttribute("data-fallback");
      if (fallback) el.src = fallback;
    });
  }
</script>

<style>
  /* Decorative ink-motion background: fixed, non-interactive, behind content. */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* Lavender-to-White gradient in the first ~third of the viewport height. */
  .top-gradient {
    position: fixed;
    inset: 0 0 auto 0;
    height: 34vh;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      var(--bg-gradient-top-start) 0%,
      var(--bg-gradient-top-end) 52%,
      transparent 100%
    );
  }

  main {
    position: relative;
    z-index: 2;
  }

  .site-footer {
    position: relative;
    z-index: 2;
    margin-top: 4rem;
    padding: 2.5rem 1.5rem 4rem;
    text-align: center;
  }

  .site-footer p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
  }
</style>