---
import { STUDIO_PROFILE } from "../lib/types/content";
import { BRAND_LOGO, WHATSAPP_PHONE } from "../lib/config";

// Placeholder social URL — replace with the studio's real Instagram handle.
const INSTAGRAM_URL = "https://instagram.com/alpiercing";
const CURRENT_YEAR = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="col brand-col">
      <a class="brand-link" href="/">
        <img class="footer-logo" src={BRAND_LOGO} alt="ALPIERCING logo" width="24" height="24" />
        <span class="footer-brand">{STUDIO_PROFILE.brand}</span>
      </a>
      <p class="footer-desc">
        Studio de perforación y joyería corporal con titanio ASTM F-136, técnica estéril y asesoría
        premium para cada anatomía.
      </p>
    </div>

    <nav class="col links-col" aria-label="Enlaces y redes">
      <h2 class="col-title">Seguinos</h2>
      <ul class="link-list">
        <li>
          <a
            class="social"
            href={INSTAGRAM_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de {STUDIO_PROFILE.brand}"
          >
            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
            Instagram
          </a>
        </li>
        <li>
          <a
            class="social"
            href={`https://wa.me/${WHATSAPP_PHONE}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp de {STUDIO_PROFILE.brand}"
          >
            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.9-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-2.9.8.8-2.8-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.6.1a6.6 6.6 0 0 1-3.7-3.3c-.3-.5.3-.5.8-1.5.1-.2 0-.4 0-.5s-.6-1.5-.8-2-.4-.5-.6-.5h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-1 2.3 5.2 5.2 0 0 0 1.1 2.8 11.8 11.8 0 0 0 4.6 4 5.2 5.2 0 0 0 3.2.4 2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c0-.2-.2-.3-.4-.4Z" />
            </svg>
            WhatsApp
          </a>
        </li>
      </ul>
    </nav>

    <div class="col credits-col">
      <h2 class="col-title">Créditos</h2>
      <p class="attribution">
        Un producto desarrollado e impulsado por&nbsp;
        <a href="https://www.forgelab.lat/" target="_blank" rel="noopener noreferrer" class="forge">
          FORGE Labs
        </a>
      </p>
    </div>
  </div>

  <p class="copy">{STUDIO_PROFILE.brand} — © {CURRENT_YEAR}</p>
</footer>

<style>
  /* Independent full-width footer section (feature 010). */
  .footer {
    position: relative;
    width: 100%;
    margin-top: 4rem;
    background: var(--bg-footer);
    border-top: 1px solid var(--divider-subtle);
    padding: 3rem 1.5rem 2rem;
  }

  .footer-inner {
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem 2rem;
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 1.5fr 1fr 1fr;
    }
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .col-title {
    margin: 0;
    color: var(--text-primary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    text-decoration: none;
    border-radius: var(--radius-pill);
  }

  .brand-link:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .footer-logo {
    height: 24px;
    width: auto;
    object-fit: contain;
    mix-blend-mode: screen;
  }

  .footer-brand {
    color: var(--text-gold);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.18em;
    text-shadow: 0 0 18px var(--accent-primary-glow);
  }

  .footer-desc {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    max-width: 42ch;
  }

  .link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-pill);
    border: var(--border-card);
    background: var(--bg-badge-pill);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
  }

  .social:hover,
  .social:focus-visible {
    color: var(--text-gold);
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-glow);
    outline: none;
  }

  .icon {
    flex: 0 0 auto;
  }

  .attribution {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .forge {
    color: var(--text-gold);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 160ms ease, border-color 160ms ease, text-shadow 160ms ease;
  }

  .forge:hover,
  .forge:focus-visible {
    color: var(--accent-primary-hover);
    border-bottom-color: var(--accent-primary);
    text-shadow: 0 0 16px var(--accent-primary-glow);
    outline: none;
  }

  .copy {
    max-width: 1080px;
    margin: 2.5rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--divider-subtle);
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .social,
    .forge {
      transition: none;
    }
  }
</style>
