---
import { STUDIO_PROFILE } from "../lib/types/content";
import { BRAND_LOGO, WHATSAPP_PHONE } from "../lib/config";

// Placeholder social URL — replace with the studio's real Instagram handle.
const INSTAGRAM_URL = "https://instagram.com/alpiercing";
const CURRENT_YEAR = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="brand-col">
      <span class="footer-brand">{STUDIO_PROFILE.brand}</span>
      <p class="footer-desc">Studio de Perforación &amp; Joyería Corporal</p>
      <div class="socials">
        <a
          href={INSTAGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="social"
          aria-label="Instagram de {STUDIO_PROFILE.brand}"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
          Instagram
        </a>
        <a
          href={`https://wa.me/${WHATSAPP_PHONE}`}
          target="_blank"
          rel="noopener noreferrer"
          class="social"
          aria-label="WhatsApp de {STUDIO_PROFILE.brand}"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.9-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-2.9.8.8-2.8-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.6.1a6.6 6.6 0 0 1-3.7-3.3c-.3-.5.3-.5.8-1.5.1-.2 0-.4 0-.5s-.6-1.5-.8-2-.4-.5-.6-.5h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-1 2.3 5.2 5.2 0 0 0 1.1 2.8 11.8 11.8 0 0 0 4.6 4 5.2 5.2 0 0 0 3.2.4 2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c0-.2-.2-.3-.4-.4Z" />
          </svg>
          WhatsApp
        </a>
      </div>
    </div>

    <p class="attribution">
      <img class="footer-logo" src={BRAND_LOGO} alt="ALPIERCING logo" width="20" height="20" />
      Un producto desarrollado e impulsado por&nbsp;
      <a
        href="https://www.forgelab.lat/"
        target="_blank"
        rel="noopener noreferrer"
        class="forge"
        >FORGE Labs</a
      >
    </p>
  </div>

  <p class="copy">
    {STUDIO_PROFILE.brand} — © {CURRENT_YEAR}
  </p>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 2;
    margin-top: 4rem;
    background: var(--bg-footer);
    border-top: 1px solid var(--divider-subtle);
    padding: 3rem 1.5rem 2.5rem;
  }

  .footer-inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-brand {
    color: var(--text-gold);
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: 0.18em;
    text-shadow: 0 0 18px var(--accent-primary-glow);
  }

  .footer-desc {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .socials {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-pill);
    border: var(--border-card);
    background: var(--bg-badge-pill);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
  }

  .social:hover,
  .social:focus-visible {
    color: var(--text-gold);
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-glow);
    outline: none;
  }

  .attribution {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .footer-logo {
    height: 20px;
    width: auto;
    object-fit: contain;
    vertical-align: middle;
    margin-right: 0.4rem;
    mix-blend-mode: screen;
  }

  .forge {
    color: var(--text-gold);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 160ms ease, border-color 160ms ease, text-shadow 160ms ease;
  }

  .forge:hover,
  .forge:focus-visible {
    color: var(--accent-primary-hover);
    border-bottom-color: var(--accent-primary);
    text-shadow: 0 0 16px var(--accent-primary-glow);
    outline: none;
  }

  .copy {
    margin: 1.75rem 0 0;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.8rem;
  }
</style>