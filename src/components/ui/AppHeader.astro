---
import { NAV_ITEMS, STUDIO_PROFILE } from "../../lib/types/content";
---

<header class="app-header">
  <div class="brand">
    <span class="brand-name">{STUDIO_PROFILE.brand}</span>
    <span class="brand-tagline">{STUDIO_PROFILE.tagline}</span>
  </div>
  <nav class="nav" aria-label="Navegación principal">
    <ul class="nav-list">
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a class="nav-link" href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .app-header {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 2rem 1.25rem 1rem;
    text-align: center;
  }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }

  .brand-name {
    color: var(--text-gold);
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: 0.18em;
    text-shadow: 0 0 18px var(--accent-primary-glow);
  }

  .brand-tagline {
    color: var(--text-secondary);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-pill);
    background: var(--bg-badge-pill);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    border: var(--border-card);
    transition: color 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--text-primary);
    background: var(--bg-pill-hover);
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }
</style>