---
import { NAV_ITEMS, STUDIO_PROFILE } from "../../lib/types/content";
import { BRAND_LOGO } from "../../lib/config";
---

<header class="app-header">
  <div class="dock">
    <img class="dock-logo" src={BRAND_LOGO} alt="ALPIERCING logo" width="32" height="32" />
    <span class="dock-brand">{STUDIO_PROFILE.brand}</span>
    <nav class="nav" aria-label="Navegación principal">
      <ul class="nav-list">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a class="nav-link" href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .app-header {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    justify-content: center;
    padding: 1rem 1.25rem 0.5rem;
  }

  /* Docked glass capsule (feature 008): dark glass pill, centered, contained width. */
  .dock {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.9rem;
    width: 100%;
    max-width: 650px;
    margin-top: 1rem;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-pill);
    background: var(--bg-navbar-glass);
    backdrop-filter: blur(var(--blur-navbar));
    -webkit-backdrop-filter: blur(var(--blur-navbar));
    border: var(--border-glass);
    box-shadow: var(--shadow-dock);
  }

  /* Brand logo on the left; white backgrounds are blended away over the dark surface. */
  .dock-logo {
    height: 32px;
    width: auto;
    object-fit: contain;
    mix-blend-mode: screen;
  }

  .dock-brand {
    color: var(--text-gold);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.14em;
    text-shadow: 0 0 18px var(--accent-primary-glow);
    white-space: nowrap;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  /* Nav links keep the pill radius (feature 008 §exclusions). */
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: color 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--text-gold);
    background: var(--bg-card-translucent);
    outline: none;
    box-shadow: inset 0 0 0 1px var(--border-glass);
  }
</style>