---
import BaseLayout from "../layouts/BaseLayout.astro";
import CartDrawer from "../components/catalog/CartDrawer.svelte";
import CatalogGrid from "../components/catalog/CatalogGrid.svelte";
import { type ProductCategory } from "../lib/types/content";

const CATEGORIES: ProductCategory[] = ["Argollas & Labrets", "Zirconia & Navel", "Aftercare"];
---

<BaseLayout
  title="Catálogo — ALPIERCING"
  description="Catálogo de joyería corporal: argollas y labrets de titanio, zirconia y navel, y kits de aftercare. Pedí tu pieza por WhatsApp."
>
  <section class="catalog">
    <div class="catalog-head">
      <h1>Catálogo</h1>
      <p>Argollas y labrets de titanio, joyería con zirconia y kits de aftercare.</p>
    </div>

    <div class="filters" role="group" aria-label="Filtrar por categoría">
      <button type="button" class="pill is-active" data-category="all" aria-pressed="true">
        Todos
      </button>
      {
        CATEGORIES.map((category) => (
          <button type="button" class="pill" data-category={category} aria-pressed="false">
            {category}
          </button>
        ))
      }
    </div>

    <CatalogGrid client:load />

    <CartDrawer client:load />
  </section>
</BaseLayout>

<style>
  .catalog {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(1.5rem, 5vw, 2.5rem) clamp(1rem, 4vw, 1.25rem);
  }

  .catalog-head {
    text-align: center;
    margin-bottom: 1.25rem;
  }

  h1 {
    margin: 0;
    font-size: 2rem;
    color: var(--text-primary);
  }

  .catalog-head p {
    margin: 0.35rem 0 0;
    color: var(--text-secondary);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .pill {
    min-height: 44px;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-pill);
    border: var(--border-card);
    background: var(--bg-badge-pill);
    color: var(--text-secondary);
    font-weight: 600;
    cursor: pointer;
  }

  .pill.is-active {
    background: var(--accent-primary);
    color: var(--accent-on);
    box-shadow: var(--shadow-glow);
  }

  .pill:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }
</style>

<style is:global>
  /* Toggled by the CartDrawer island (data-category filter), applied to catalog grid cards. */
  .is-hidden {
    display: none !important;
  }
</style>