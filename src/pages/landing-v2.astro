---
import BaseLayout from "../layouts/BaseLayout.astro";
import LandingV2Services from "../components/landing/LandingV2Services.svelte";
import LandingV2Sidebar from "../components/landing/LandingV2Sidebar.svelte";
import TeamSection from "../components/team/TeamSection.svelte";
import { BOOKING_POLICY, GALLERY_ITEMS, STUDIO_PROFILE } from "../lib/types/content";
import { INSTAGRAM_URL, WHATSAPP_PHONE } from "../lib/config";

// Static display label; the sidebar card computes the live open/closed status (feature 015).
const OPENING_HOURS = "Lun–Sáb · 11:00–20:00";

const ANCHORS = [
  { href: "#servicios", label: "Servicios" },
  { href: "#equipo", label: "Equipo" },
  { href: "#acerca-de", label: "Acerca de" },
  { href: "#galeria", label: "Galería" },
  { href: "#resenas", label: "Reseñas" },
  { href: "#direccion", label: "Dirección" },
];
---

<BaseLayout
  title="ALPIERCING — Reservas Online"
  description="Reservá tu piercing online 24/7 en El Tigre, Anzoátegui: perfil del estudio, servicios por categoría, equipo de perforadores y trabajos destacados."
>
  <div class="landing-v2">
    <nav class="anchor-nav" aria-label="Secciones del estudio">
      {
        ANCHORS.map((anchor) => (
          <a class="anchor-link" href={anchor.href}>
            {anchor.label}
          </a>
        ))
      }
    </nav>

    <div class="layout">
      <div class="content">
        <!-- 1. Booking policy / advisory banner -->
        <section class="policy" id="politica" aria-labelledby="policy-title" role="note">
          <h2 id="policy-title">{BOOKING_POLICY.title}</h2>
          <p>{BOOKING_POLICY.body}</p>
        </section>

        <!-- 2. Services (grouped accordion from the managed data layer) -->
        <section class="block" id="servicios" aria-labelledby="services-title">
          <h2 id="services-title">Servicios</h2>
          <p class="lead">Elegí tu perforación y reservá en segundos.</p>
          <LandingV2Services client:load />
        </section>

        <!-- 3. Team -->
        <section class="block" id="equipo" aria-label="Equipo">
          <TeamSection client:visible />
        </section>

        <!-- 4. About -->
        <section class="block" id="acerca-de" aria-labelledby="about-title">
          <h2 id="about-title">Acerca de</h2>
          <p class="bio">{STUDIO_PROFILE.bio}</p>
        </section>

        <!-- 5. Gallery -->
        <section class="block" id="galeria" aria-labelledby="gallery-title">
          <h2 id="gallery-title">Galería</h2>
          <div class="gallery">
            {
              GALLERY_ITEMS.map((item) => (
                <figure class="tile">
                  <img
                    src={item.image}
                    alt={item.alt}
                    loading="lazy"
                    data-fallback="/images/placeholder.svg"
                  />
                  {item.label && <figcaption>{item.label}</figcaption>}
                </figure>
              ))
            }
          </div>
        </section>

        <!-- 6. Address / Contact -->
        <section class="block" id="direccion" aria-labelledby="address-title">
          <h2 id="address-title">Dirección</h2>
          <p class="address">📍 {STUDIO_PROFILE.location}</p>
          <p class="hours">🕒 {OPENING_HOURS}</p>
          <div class="contact-actions">
            <a
              class="contact"
              href={INSTAGRAM_URL}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Instagram de ${STUDIO_PROFILE.brand}`}
            >
              Instagram
            </a>
            <a
              class="contact"
              href={`https://wa.me/${WHATSAPP_PHONE}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`WhatsApp de ${STUDIO_PROFILE.brand}`}
            >
              WhatsApp
            </a>
          </div>
        </section>
      </div>

      <aside class="side" aria-label="Resumen del estudio">
        <LandingV2Sidebar client:load />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .landing-v2 {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(1.25rem, 4vw, 2rem) clamp(1rem, 4vw, 1.5rem) clamp(2.5rem, 6vw, 4rem);
  }

  .anchor-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: clamp(1.25rem, 3vw, 1.75rem);
  }

  .anchor-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    border: var(--border-card);
    background: var(--bg-badge-pill);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .anchor-link:hover,
  .anchor-link:focus-visible {
    color: var(--text-gold);
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-glow);
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.25rem);
    align-items: start;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.25rem);
    min-width: 0;
  }

  section[id] {
    scroll-margin-top: 5.5rem;
  }

  .policy,
  .block {
    background: var(--bg-card-light);
    border: var(--border-card);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: clamp(1.25rem, 4vw, 1.75rem);
    min-width: 0;
  }

  .policy {
    border-color: var(--accent-wood);
  }

  h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.35rem, 4vw, 1.7rem);
    color: var(--text-primary);
  }

  .policy h2 {
    font-size: 1.05rem;
    color: var(--text-gold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .policy p,
  .bio {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .lead {
    margin: 0 0 1.25rem;
    color: var(--text-secondary);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .tile {
    position: relative;
    margin: 0;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--bg-card-light);
    border: var(--border-card);
    border-radius: var(--radius-card);
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tile figcaption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    background: var(--bg-badge-pill);
    color: var(--text-primary);
    font-weight: 700;
    font-size: 0.78rem;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
  }

  .address,
  .hours {
    margin: 0 0 0.35rem;
    color: var(--text-secondary);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .contact {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    border: var(--border-card);
    background: var(--bg-badge-pill);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .contact:hover,
  .contact:focus-visible {
    color: var(--text-gold);
    border-color: var(--accent-primary);
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .side {
    min-width: 0;
  }

  @media (min-width: 768px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 340px;
    }

    .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .side {
      position: sticky;
      top: 5rem;
    }
  }

  @media (min-width: 1024px) {
    .gallery {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .anchor-link,
    .contact {
      transition: none;
    }
  }
</style>
