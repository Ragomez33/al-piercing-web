---
import BaseLayout from "../layouts/BaseLayout.astro";
import LandingV2Tabs from "../components/landing/LandingV2Tabs.svelte";
import { STUDIO_PROFILE } from "../lib/types/content";
import { BRAND_LOGO, WHATSAPP_PHONE } from "../lib/config";

// Page-local profile details for the alternative landing (feature 013).
// Kept here (not in shared content/config) so this experimental variant is self-contained.
const OPENING_HOURS = "Lun–Sáb · 11:00–20:00";
const INSTAGRAM_URL = "https://instagram.com/alpiercing";
---

<BaseLayout
  title="ALPIERCING — Reservas Online"
  description="Reservá tu piercing online 24/7: perfil del estudio, servicios por categoría con duración y precio, equipo de perforadores y trabajos destacados."
>
  <section class="landing-v2">
    <header class="profile" aria-labelledby="profile-title">
      <div class="identity">
        <img class="profile-avatar" src={BRAND_LOGO} alt={`${STUDIO_PROFILE.brand} logo`} width="72" height="72" />
        <div class="identity-text">
          <h1 id="profile-title">{STUDIO_PROFILE.brand}</h1>
          <p class="tagline">{STUDIO_PROFILE.tagline}</p>
        </div>
      </div>

      <p class="bio">{STUDIO_PROFILE.bio}</p>

      <div class="meta">
        <span class="meta-item">📍 {STUDIO_PROFILE.location}</span>
        <span class="meta-item">🕒 {OPENING_HOURS}</span>
      </div>

      <div class="profile-actions">
        <span class="status-badge">Reservas Online 24/7</span>

        <div class="socials">
          <a
            class="social"
            href={INSTAGRAM_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Instagram de ${STUDIO_PROFILE.brand}`}
          >
            <svg class="social-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
            Instagram
          </a>

          <a
            class="social"
            href={`https://wa.me/${WHATSAPP_PHONE}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`WhatsApp de ${STUDIO_PROFILE.brand}`}
          >
            <svg class="social-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.9-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-2.9.8.8-2.8-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.6.1a6.6 6.6 0 0 1-3.7-3.3c-.3-.5.3-.5.8-1.5.1-.2 0-.4 0-.5s-.6-1.5-.8-2-.4-.5-.6-.5h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-1 2.3 5.2 5.2 0 0 0 1.1 2.8 11.8 11.8 0 0 0 4.6 4 5.2 5.2 0 0 0 3.2.4 2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c0-.2-.2-.3-.4-.4Z" />
            </svg>
            WhatsApp
          </a>
        </div>
      </div>
    </header>

    <LandingV2Tabs client:load />
  </section>
</BaseLayout>

<style>
  .landing-v2 {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(1.5rem, 5vw, 2.5rem) clamp(1rem, 4vw, 1.5rem) 0;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.25rem);
  }

  .profile {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    background: var(--bg-card-light);
    border: var(--border-card);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .profile-avatar {
    width: 72px;
    height: 72px;
    flex: 0 0 auto;
    object-fit: contain;
    border-radius: var(--radius-image);
    background: var(--bg-surface-elevated);
    border: var(--border-card);
    padding: 0.4rem;
    mix-blend-mode: screen;
  }

  .identity-text {
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.5rem, 5vw, 2rem);
    letter-spacing: 0.06em;
    color: var(--text-gold);
    overflow-wrap: anywhere;
  }

  .tagline {
    margin: 0.15rem 0 0;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bio {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 62ch;
    overflow-wrap: anywhere;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .meta-item {
    overflow-wrap: anywhere;
  }

  .profile-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    background: var(--accent-primary);
    color: var(--accent-on);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    box-shadow: var(--shadow-glow);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-pill);
    border: var(--border-card);
    background: var(--bg-badge-pill);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .social:hover,
  .social:focus-visible {
    color: var(--text-gold);
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-glow);
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .social-icon {
    flex: 0 0 auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .social {
      transition: none;
    }
  }
</style>
