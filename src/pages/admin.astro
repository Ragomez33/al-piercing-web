---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PRODUCTS } from "../lib/types/content";
import { PIERCING_SERVICES } from "../lib/data/services";

// Static overview for the private studio panel. Live appointment/deposit data
// will be wired to PocketBase in a later iteration.
const sections = [
  {
    key: "services",
    label: "Servicios publicados",
    value: PIERCING_SERVICES.length,
    hint: "Perforaciones activas en el menú de reservas",
  },
  {
    key: "products",
    label: "Productos en catálogo",
    value: PRODUCTS.length,
    hint: "Joyería, aftercare e insumos",
  },
  {
    key: "pending",
    label: "Señas por validar",
    value: 0,
    hint: "Comprobantes enviados por WhatsApp",
  },
];

const lowStock = PRODUCTS.filter((product) => product.stock <= 5);
---

<BaseLayout title="Panel — ALPIERCING">
  <section class="admin">
    <header class="admin-head">
      <h1>Panel del Estudio</h1>
      <p>Resumen privado de servicios, catálogo y reservas.</p>
    </header>

    <div class="stats">
      {
        sections.map((section) => (
          <article class="card stat">
            <span class="stat-value">{section.value}</span>
            <h2>{section.label}</h2>
            <p>{section.hint}</p>
          </article>
        ))
      }
    </div>

    <section class="panel" aria-labelledby="stock-title">
      <h2 id="stock-title">Stock bajo</h2>
      {lowStock.length === 0 ? (
        <p class="empty">Todo el catálogo tiene stock suficiente.</p>
      ) : (
        <ul class="stock-list">
          {lowStock.map((product) => (
            <li class="stock-row">
              <span>{product.name}</span>
              <span class={product.stock === 0 ? "out" : ""}>{product.stock} u.</span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <p class="note">
      La gestión de citas y la validación de comprobantes se conectarán a PocketBase en una próxima
      entrega.
    </p>
  </section>
</BaseLayout>

<style>
  .admin {
    max-width: 900px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem;
  }

  .admin-head {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  h1 {
    margin: 0;
    font-size: 2rem;
    color: var(--text-primary);
  }

  .admin-head p {
    margin: 0.35rem 0 0;
    color: var(--text-secondary);
  }

  .stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .card {
    background: var(--bg-card-light);
    border: var(--border-card);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .stat {
    padding: 1.25rem;
    text-align: center;
  }

  .stat-value {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    height: 48px;
    padding: 0 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--accent-primary);
    color: var(--accent-on);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    box-shadow: var(--shadow-glow);
  }

  .stat h2 {
    margin: 0.75rem 0 0.25rem;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .stat p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .panel {
    background: var(--bg-card-light);
    border: var(--border-card);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: 1.25rem;
  }

  .panel h2 {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
    color: var(--text-primary);
  }

  .stock-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stock-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.75rem;
    border: var(--border-card);
    border-radius: var(--radius-image);
    color: var(--text-secondary);
  }

  .stock-row span:last-child {
    font-weight: 700;
    color: var(--accent-gold);
    font-variant-numeric: tabular-nums;
  }

  .stock-row span.out {
    color: var(--accent-negative);
  }

  .empty {
    margin: 0;
    color: var(--text-muted);
  }

  .note {
    margin: 1.5rem 0 0;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  @media (min-width: 768px) {
    .stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
