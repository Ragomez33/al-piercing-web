# ALPIERCING — Variables de entorno
# Copia este archivo a `.env.local` para desarrollo o define las variables en tu hosting.
# Todas son PUBLIC_* (seguras para incluir en el bundle del cliente; NO pongas secretos).

# URL pública del sitio (SEO): base para canonical, OpenGraph, JSON-LD, robots.txt y sitemap.
# Usada en build (astro.config.mjs → proceso `SITE`). Fallback: https://alpiercing.com
SITE=https://alpiercing.com

# WhatsApp destino (solo dígitos, con código de país). Fallback en src/lib/config.ts.
PUBLIC_WHATSAPP_PHONE=5215500000000

# Referencias de pago mostradas en el resumen de la seña (placeholders hasta configurar).
PUBLIC_PAGO_MOVIL_REF=0414-000-0000
PUBLIC_BINANCE_PAY_ID=ALPIERCING-PAY

# Supabase — deja AMBAS vacías para usar el Modo Demo (localStorage).
# Si se definen, la app conmuta automáticamente a Producción.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Administración (/admin): utiliza Supabase Auth con email/contraseña (sin PIN).
# Crea el usuario operador en Supabase → Authentication → Users (o activa sign-up en dev)
# y aplica el esquema: supabase/migrations/0001_init.sql + 0002_admin_auth.sql.